* text=auto eol=lf

# Keep Windows shell scripts CRLF for compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Common binary assets.
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.zip binary
*.7z binary
*.gz binary
*.tar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
